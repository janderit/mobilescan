# MobileScan static hosting on uberspace (Apache). This file is deployed to
# the app/ directory; the product page at the site root is served without it.
# No rewrite rules: this is a plain static file deployment.

AddType application/manifest+json .webmanifest
AddType application/javascript .mjs

# <Files>/<FilesMatch> only match the basename, so hashed files under
# /assets/ are tagged via SetEnvIf on the request URI instead (mod_setenvif,
# not mod_rewrite).
SetEnvIf Request_URI "^/app/assets/" MOBILESCAN_IMMUTABLE

<IfModule mod_headers.c>
    # Lets the service worker at /app/sw.js control the /app/ scope.
    <Files "sw.js">
        Header set Service-Worker-Allowed "/app/"
    </Files>

    # Never let the browser/proxy cache the files that decide which build is
    # active (version.json is what the in-app update check reads); the hashed
    # assets below are cached forever instead.
    <FilesMatch "^(sw\.js|index\.html|manifest\.webmanifest|version\.json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    Header set Cache-Control "max-age=31536000, immutable" env=MOBILESCAN_IMMUTABLE
</IfModule>
